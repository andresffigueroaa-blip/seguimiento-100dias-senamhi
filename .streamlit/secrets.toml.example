# Copiar como secrets.toml (local) o pegar en Streamlit Cloud > App > Settings > Secrets.
# secrets.toml NO se sube a GitHub.

# Pestañas del Google Sheet publicadas como CSV
# (Archivo > Compartir > Publicar en la web > pestaña > Valores separados por comas)
SEG100_CALCULOS_CSV = ""
SEG100_HISTORIAL_CSV = ""
