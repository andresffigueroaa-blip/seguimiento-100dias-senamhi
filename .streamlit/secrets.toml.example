# Enlace para abrir el Sheet desde el dashboard (el normal, de edición)
SEG100_SHEET_URL = ""

# Clave adicional para entrar (vacía = sin clave; en Streamlit Cloud la app
# ya es privada por correo, esta clave es una segunda capa).
PASSWORD = ""
